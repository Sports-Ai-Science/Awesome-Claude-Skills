  "test_design_specifications": [
    {
      "id": "TDS-001",
      "feature": "ユーザー登録",
      "srs_references": ["SRS-FR-001", "SRS-FR-002"],
      "approach": "同値分割と境界値分析を使用。正常系（有効なメール・パスワード）、異常系（無効な入力、重複メール）、境界値（パスワード長）のテストケースを作成。",
      "test_techniques": ["equivalence_partitioning", "boundary_value_analysis"],
      "pass_criteria": "全テストケースが期待結果と一致",
      "test_case_ids": ["TC-0001", "TC-0002", "TC-0003", "TC-0010", "TC-0011"]
    },
    {
      "id": "TDS-002",
      "feature": "ユーザーログイン",
      "srs_references": ["SRS-FR-003", "SRS-FR-004"],
      "approach": "正常系（正しい認証情報）、異常系（誤った認証情報、未登録ユーザー）、セキュリティ（アカウントロック）のテストケースを作成。",
      "test_techniques": ["equivalence_partitioning", "error_guessing"],
      "pass_criteria": "全テストケースが期待結果と一致",
      "test_case_ids": ["TC-0020", "TC-0021", "TC-0022", "TC-0023"]
    },
    {
      "id": "TDS-003",
      "feature": "パスワードリセット",
      "srs_references": ["SRS-FR-005"],
      "approach": "正常系（登録済みメール）、異常系（未登録メール）のテストケースを作成。セキュリティ考慮でメール存在有無を露出しないことを確認。",
      "test_techniques": ["equivalence_partitioning", "use_case"],
      "pass_criteria": "全テストケースが期待結果と一致",
      "test_case_ids": ["TC-0030", "TC-0031"]
    }
  ],
  "test_cases": [
    {
      "id": "TC-0001",
      "title": "正常なメールアドレスとパスワードでユーザー登録が成功する",
      "objective": "有効な入力データでユーザー登録APIが正常に動作することを検証する",
      "srs_reference": "SRS-FR-001",
      "test_design_reference": "TDS-001",
      "priority": "critical",
      "test_type": "positive",
      "automation_status": "automated",
      "preconditions": [
        "テスト用DBが初期化されている",
        "メールサービスがモック化されている",
        "test@example.comが未登録である"
      ],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "test@example.com", "description": "有効なメールアドレス"},
          {"name": "password", "value": "SecurePass123!", "description": "有効なパスワード（8文字以上、英大小文字・数字を含む）"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/register を呼び出す", "input": "{\"email\": \"test@example.com\", \"password\": \"SecurePass123!\"}"},
        {"step_number": 2, "action": "レスポンスステータスを確認", "expected_result": "201 Created"},
        {"step_number": 3, "action": "レスポンスボディを確認", "expected_result": "user_id (UUID形式) が含まれる"},
        {"step_number": 4, "action": "DBにユーザーが作成されたことを確認", "expected_result": "ユーザーレコードが存在"}
      ],
      "expected_results": [
        "HTTPステータス 201 が返される",
        "レスポンスに user_id (UUID形式) が含まれる",
        "DBにユーザーレコードが作成される",
        "パスワードがハッシュ化されて保存される"
      ],
      "postconditions": ["ユーザーレコードがDBに存在する"],
      "cleanup": ["作成したテストユーザーを削除"]
    },
    {
      "id": "TC-0002",
      "title": "既に登録済みのメールアドレスで登録するとエラーになる",
      "objective": "重複メールアドレスでの登録が拒否されることを検証する",
      "srs_reference": "SRS-FR-001",
      "test_design_reference": "TDS-001",
      "priority": "high",
      "test_type": "negative",
      "automation_status": "automated",
      "preconditions": [
        "existing@example.comが既に登録済みである"
      ],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "existing@example.com", "description": "既存のメールアドレス"},
          {"name": "password", "value": "SecurePass123!"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/register を呼び出す"},
        {"step_number": 2, "action": "レスポンスステータスを確認", "expected_result": "409 Conflict"}
      ],
      "expected_results": [
        "HTTPステータス 409 が返される",
        "エラーメッセージが返される"
      ]
    },
    {
      "id": "TC-0003",
      "title": "無効なメール形式で登録するとエラーになる",
      "objective": "無効なメールアドレスでバリデーションエラーが発生することを検証する",
      "srs_reference": "SRS-FR-001",
      "test_design_reference": "TDS-001",
      "priority": "high",
      "test_type": "negative",
      "automation_status": "automated",
      "preconditions": ["テスト用DBが初期化されている"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "invalid-email", "description": "無効なメール形式"},
          {"name": "password", "value": "SecurePass123!"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/register を呼び出す"},
        {"step_number": 2, "action": "レスポンスステータスを確認", "expected_result": "400 Bad Request"}
      ],
      "expected_results": [
        "HTTPステータス 400 が返される",
        "エラーメッセージに'email'が含まれる"
      ]
    },
    {
      "id": "TC-0010",
      "title": "パスワードが8文字未満でエラーになる",
      "objective": "短いパスワードでバリデーションエラーが発生することを検証する",
      "srs_reference": "SRS-FR-002",
      "test_design_reference": "TDS-001",
      "priority": "high",
      "test_type": "boundary",
      "automation_status": "automated",
      "preconditions": ["テスト用DBが初期化されている"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "test@example.com"},
          {"name": "password", "value": "Short1!", "description": "7文字（境界値-1）"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/register を呼び出す"},
        {"step_number": 2, "action": "レスポンスを確認", "expected_result": "400 Bad Request"}
      ],
      "expected_results": [
        "HTTPステータス 400 が返される",
        "エラーメッセージにパスワード長の制約が含まれる"
      ]
    },
    {
      "id": "TC-0011",
      "title": "パスワードが8文字でちょうど登録できる",
      "objective": "境界値（8文字）のパスワードで登録が成功することを検証する",
      "srs_reference": "SRS-FR-002",
      "test_design_reference": "TDS-001",
      "priority": "high",
      "test_type": "boundary",
      "automation_status": "automated",
      "preconditions": ["テスト用DBが初期化されている"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "boundary@example.com"},
          {"name": "password", "value": "Secure1!", "description": "8文字（境界値）"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/register を呼び出す"},
        {"step_number": 2, "action": "レスポンスを確認", "expected_result": "201 Created"}
      ],
      "expected_results": ["HTTPステータス 201 が返される"]
    },
    {
      "id": "TC-0020",
      "title": "正しい認証情報でログインが成功する",
      "objective": "有効な認証情報でログインが成功し、JWTが発行されることを検証する",
      "srs_reference": "SRS-FR-003",
      "test_design_reference": "TDS-002",
      "priority": "critical",
      "test_type": "positive",
      "automation_status": "automated",
      "preconditions": ["user@example.com/Password123!で登録済み"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "user@example.com"},
          {"name": "password", "value": "Password123!"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/login を呼び出す"},
        {"step_number": 2, "action": "レスポンスステータスを確認", "expected_result": "200 OK"},
        {"step_number": 3, "action": "レスポンスボディを確認", "expected_result": "access_token, refresh_token, expires_in が含まれる"}
      ],
      "expected_results": [
        "HTTPステータス 200 が返される",
        "access_token (JWT形式) が返される",
        "refresh_token が返される",
        "expires_in が返される"
      ]
    },
    {
      "id": "TC-0021",
      "title": "間違ったパスワードでログインが失敗する",
      "objective": "誤ったパスワードでログインが拒否されることを検証する",
      "srs_reference": "SRS-FR-004",
      "test_design_reference": "TDS-002",
      "priority": "high",
      "test_type": "negative",
      "automation_status": "automated",
      "preconditions": ["user@example.com/Password123!で登録済み"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "user@example.com"},
          {"name": "password", "value": "WrongPassword!"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/login を呼び出す"},
        {"step_number": 2, "action": "レスポンスを確認", "expected_result": "401 Unauthorized"}
      ],
      "expected_results": [
        "HTTPステータス 401 が返される",
        "汎用エラーメッセージが返される（パスワード間違いを明示しない）"
      ]
    },
    {
      "id": "TC-0022",
      "title": "未登録メールアドレスでログインが失敗する",
      "objective": "未登録のメールアドレスでログインが拒否されることを検証する",
      "srs_reference": "SRS-FR-004",
      "test_design_reference": "TDS-002",
      "priority": "high",
      "test_type": "negative",
      "automation_status": "automated",
      "preconditions": ["nonexistent@example.comが未登録である"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "nonexistent@example.com"},
          {"name": "password", "value": "Password123!"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/login を呼び出す"},
        {"step_number": 2, "action": "レスポンスを確認", "expected_result": "401 Unauthorized"}
      ],
      "expected_results": [
        "HTTPステータス 401 が返される",
        "TC-0021と同じエラーメッセージが返される（メール存在を明示しない）"
      ]
    },
    {
      "id": "TC-0023",
      "title": "5回連続でログイン失敗するとアカウントがロックされる",
      "objective": "ブルートフォース対策のアカウントロック機能を検証する",
      "srs_reference": "SRS-NFR-005",
      "test_design_reference": "TDS-002",
      "priority": "high",
      "test_type": "security",
      "automation_status": "automated",
      "preconditions": ["user@example.com/Password123!で登録済み"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "user@example.com"},
          {"name": "password", "value": "WrongPassword!"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "間違ったパスワードで5回連続ログイン試行"},
        {"step_number": 2, "action": "6回目のログイン試行（正しいパスワード）", "expected_result": "403 Forbidden"}
      ],
      "expected_results": [
        "6回目のログインで403が返される",
        "アカウントロックのエラーメッセージが返される",
        "15分後にロックが解除される"
      ]
    },
    {
      "id": "TC-0030",
      "title": "登録済みメールアドレスでパスワードリセットが成功する",
      "objective": "パスワードリセットメールが送信されることを検証する",
      "srs_reference": "SRS-FR-005",
      "test_design_reference": "TDS-003",
      "priority": "medium",
      "test_type": "positive",
      "automation_status": "automated",
      "preconditions": ["user@example.comが登録済み", "メールサービスがモック化されている"],
      "test_data": {
        "inputs": [
          {"name": "email", "value": "user@example.com"}
        ]
      },
      "test_steps": [
        {"step_number": 1, "action": "POST /api/auth/password-reset を呼び出す"},
        {"step_number": 2, "action": "レスポンスを確認", "expected_result": "200 OK"},
        {"step_number": 3, "action": "メール送信を確認", "expected_result": "リセットリンク付きメールが送信される"}
      ],
